# Staging-only response headers.
#
# SAFETY: do not rename this file to ".htaccess" anywhere in this repository.
# It is committed as ".htaccess.staging" so it can never be picked up by the
# production docroot by accident.
#
# To apply, upload this file's contents to the STAGING docroot as ".htaccess",
# e.g. /home/<cpanel-user>/staging.treasurelandschools.com/.htaccess
# then verify with:
#   curl.exe -sSI https://staging.treasurelandschools.com/
# and look for: x-robots-tag: noindex, nofollow, noarchive

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Fallback for hosts where mod_headers is unavailable: send a robots.txt that
# disallows everything. Uncomment only on staging.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteRule ^robots\.txt$ - [R=200,L]
# </IfModule>

# ---------------------------------------------------------------
# Optional: password-protect staging so only the team can see it.
# 1. Create the password file on the server:
#      htpasswd -c /home/<cpanel-user>/.htpasswd-staging tes
# 2. Uncomment the block below.
# ---------------------------------------------------------------
# AuthType Basic
# AuthName "Treasureland staging - authorised users only"
# AuthUserFile /home/<cpanel-user>/.htpasswd-staging
# Require valid-user
